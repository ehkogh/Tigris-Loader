[logging]
; Open a separate log viewer when the loader initializes.
console=1
; Mirror native Tiger/D2 retail messages to the console and d2_mod_loader.log.
game_logs=1
; Native category threshold: 0 = most verbose, 5 = least verbose.
game_verbosity=0

[sku]
; Accept plaintext and headerless encrypted configs (required for auto_decrypt).
allow_unsigned=1
; Convert encrypted sku_config.txt beside Destiny2.exe to editable plaintext.
; Preserve the encrypted original as sku_config.txt.encrypted.bak.
; To keep a signed retail file unchanged, set both SKU options to 0.
auto_decrypt=1

[steam]
original_dll=steam_api64_original.dll

[server]
; Remove only the Client's private in-memory CA bundle so ordinary HTTPS certificates work.
remove_pinning=1
; Development-only: also disable HTTPS peer/hostname verification for self-signed certificates.
allow_self_signed=0
; Optional PKCS#1 DER RSA-2048 public key for custom content manifests.
; Relative paths are resolved beside steam_api64.dll. Leave empty for Bungie's retail key.
manifest_public_key=

[mods]
directory=mods

[packages]
register_discovered=1
